# Banco local (SQLite). Ver research.md R-03.
DATABASE_URL="file:./dev.db"

# Chave do Gemini. Lida exclusivamente no servidor — nunca prefixar com NEXT_PUBLIC_.
GEMINI_API_KEY=""

# Segredo de sessão do Auth.js.
# Gerar com: npx auth secret
AUTH_SECRET=""

# Chave de cifragem dos campos sensíveis em repouso (research.md R-08).
# 32 bytes em base64. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVE_CRIPTO="="

# Segredo que protege a rota de retenção agendada (FR-018, FR-026).
CRON_SECRET=""
