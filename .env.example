# Banco local (SQLite). Ver research.md R-03.
DATABASE_URL="file:./dev.db"

# Chave do OpenRouter — provedor único de IA (texto e transcrição).
# Lida exclusivamente no servidor — nunca prefixar com NEXT_PUBLIC_.
OPENROUTER_API_KEY=""

# Opcionais — sobrescrevem os modelos padrão (research.md R-04).
#   OPENROUTER_MODELO_RAPIDO="deepseek/deepseek-v4-flash-0731"
#   OPENROUTER_MODELO_CAPAZ="deepseek/deepseek-v4-flash-0731"
#   OPENROUTER_MODELO_TRANSCRICAO="mistralai/voxtral-mini-transcribe"

# Segredo de sessão do Auth.js.
# Gerar com: npx auth secret
AUTH_SECRET=""

# Chave de cifragem dos campos sensíveis em repouso (research.md R-08).
# 32 bytes em base64. Gerar com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CHAVE_CRIPTO="="

# Segredo que protege a rota de retenção agendada (FR-018, FR-026).
CRON_SECRET=""
